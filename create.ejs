<html>
    <head>
        <title>Home Page</title>
        <link rel="stylesheet" href="styles2.css">
    </head>
    <body>
        <h1>Create New Blog Post</h1>

        <form action="/postblog" method="POST">
            <div class="createsect">
            <label class="b-label" for="b-title">Title</label>
            <input type="text" name="b-title" required>
            </div>
            <div class="createsect">
            <label class="b-label" for="b-author">Author</label>
            <input type="text" name="b-author" required>
            </div>
            <div class="createsect">
            <label class="b-label" for="b-content">Content</label>
            <textarea id="contentfield" name="b-content" required></textarea>
            </div>
            <input id="createbutton" type="submit" value="Create Blog Post"/>
        </form>
    </body>
</html>