<html>
    <head>
        <title>Home Page</title>
        <link rel="stylesheet" href="styles2.css">
    </head>
    <body>
        <h1>Edit Blog Post</h1>

        <form action="/saveblog" method="POST">
            <div class="createsect">
            <label class="b-label" for="b-title">Title</label>
            <input type="text" name="b-title" value="<%=thisBlog.title%>" required>
            </div>
            <div class="createsect">
            <label class="b-label" for="b-author">Author</label>
            <input type="text" name="b-author" value="<%=thisBlog.author%>" required></input>
            </div>
            <div class="createsect">
            <label class="b-label" for="b-content">Content</label>
            <textarea id="contentfield" name="b-content" required><%=thisBlog.content%></textarea>
            </div>
            <input hidden="true" name="saveindex" value="<%=blogIndex%>"></input>
            <input id="savebutton" type="submit" value="Save Blog Post"/>
        </form>
    </body>
</html>