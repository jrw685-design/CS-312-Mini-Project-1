<html>
    
    <head>
        <link rel="stylesheet" href="styles1.css">
        <title>Home Page</title>
    </head>
    <body>
        <h1>Mini-Project 1</h1>
        
        <form id="c-blog" action="/createblog" method="POST">
            <button id="create-button" type="submit">Add New Blog Post</button>
        </form>
        
        <div id="blog-posts">
            <% for (i=blogList.length-1; i >= 0; i--) { %>
            <div class="b-single-post">
                
                
                
                <div class="blog-top">
                <h2><%= blogList[i].title %></h2>
                <div class="blog-author"><h3><%= blogList[i].author %></h3></div>
                </div>
                
                <div class="blog-body">
                
                
                <div class="blog-content"><h3><%= blogList[i].content %></h3></div>
                <div class="blog-date"><h3><%= blogList[i].date %></h3></div>
                </div>
                <div class="blog-controls">
                <form action="/edblog" method="POST">
                    <input hidden="true" name="bindex" value="<%=i%>"></input>
                    
                    <input id="editbutton" type="submit" value="Edit">
                </form>
                <form action="/delblog" method="POST">
                    <input hidden="true" name="delbutton" value="<%=i%>"></input>
                    <input id="deletebutton" type="submit" value="Delete">
                </form>
                </div>
            </div>
            <% }%>
            
        </div>
    </body>
</html>